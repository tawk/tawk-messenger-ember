{
  "name": "@tawk.to/tawk-messenger-ember",
  "version": "2.0.0",
  "description": "Official Ember plugin for Tawk messenger",
  "keywords": [
    "ember-addon",
    "emberjs",
    "ember",
    "ember-plugin",
    "tawk",
    "tawkto",
    "ember-tawk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tawk/tawk-messenger-ember.git",
    "repository": "tawk/tawk-messenger-ember"
  },
  "homepage": "https://github.com/tawk/tawk-messenger-ember#readme",
  "bugs": {
    "url": "https://github.com/tawk/tawk-messenger-ember/issues",
    "email": "support@tawk.to"
  },
  "license": "Apache-2.0",
  "author": "Jerald Austero <jerald.austero@tawk.to> (https://www.tawk.to)",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "build": "ember build --environment=production",
    "lint": "npm-run-all --aggregate-output --continue-on-error --parallel \"lint:!(fix)\"",
    "lint:fix": "npm-run-all --aggregate-output --continue-on-error --parallel lint:*:fix",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:types": "tsc --noEmit",
    "start": "ember serve",
    "test": "npm-run-all lint test:*",
    "test:ember": "ember test",
    "test:ember-compatibility": "ember try:each"
  },
  "dependencies": {
    "ember-cli-babel": "^8.2.0",
    "ember-cli-htmlbars": "^6.3.0"
  },
  "devDependencies": {
    "@ember/optional-features": "^2.2.0",
    "@ember/test-helpers": "^4.0.4",
    "@embroider/test-setup": "^4.0.0",
    "@glimmer/component": "^1.1.2",
    "@glimmer/tracking": "^1.1.2",
    "@tsconfig/ember": "^3.0.8",
    "@types/qunit": "^2.19.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "broccoli-asset-rev": "^3.0.0",
    "ember-auto-import": "^2.10.0",
    "ember-cli": "~6.8.0",
    "ember-cli-dependency-checker": "^3.3.2",
    "ember-cli-inject-live-reload": "^2.1.0",
    "ember-cli-sri": "^2.1.1",
    "ember-cli-terser": "^4.0.2",
    "ember-load-initializers": "^2.1.2",
    "ember-page-title": "^8.2.3",
    "ember-qunit": "^9.0.1",
    "ember-resolver": "^13.0.2",
    "ember-source": "~6.8.0",
    "ember-source-channel-url": "^3.0.0",
    "ember-template-lint": "^6.0.0",
    "ember-try": "^3.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-ember": "^12.3.0",
    "eslint-plugin-n": "^17.15.0",
    "eslint-plugin-prettier": "^5.2.0",
    "eslint-plugin-qunit": "^8.1.2",
    "loader.js": "^4.7.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.4.2",
    "qunit": "^2.24.1",
    "qunit-dom": "^3.3.0",
    "typescript": "^5.6.0",
    "webpack": "^5.97.0"
  },
  "engines": {
    "node": ">= 20"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "configPath": "tests/dummy/config"
  }
}
